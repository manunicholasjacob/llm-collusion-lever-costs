diff --git a/src/continuous_double_auction/util/misc.py b/src/continuous_double_auction/util/misc.py
index e083f52..4bcb659 100644
--- a/src/continuous_double_auction/util/misc.py
+++ b/src/continuous_double_auction/util/misc.py
@@ -2,0 +3 @@ import logging
+import os
@@ -7 +8,22 @@ import numpy as np
-from src.resources.model_wrappers import ModelWrapper, OpenAIClient, AnthropicClient, GoogleClient
+from src.resources.model_wrappers import ModelWrapper, OpenAIClient, OpenAICompatibleClient, AnthropicClient, GoogleClient
+
+
+def local_backend() -> dict | None:
+    """Alternative backend on any OpenAI-compatible server (OpenRouter, Ollama, vLLM).
+    LLM_MODEL_MAP="gpt-4.1=meta-llama/llama-3.3-70b-instruct,gpt-4.1-mini=openai/gpt-4.1-mini" routes each
+    configured model name (agents use gpt-4.1, the overseer and judge use gpt-4.1-mini) to a backend model;
+    LOCAL_LLM_MODEL=x routes every name not in the map to x. simulation.py records this in the run metadata."""
+    model = os.environ.get("LOCAL_LLM_MODEL")
+    mapping = dict(pair.split("=", 1) for pair in os.environ.get("LLM_MODEL_MAP", "").split(",") if "=" in pair)
+    if not model and not mapping:
+        return None
+    return {"model": model, "map": mapping,
+            "base_url": os.environ.get("LOCAL_LLM_BASE_URL", "http://localhost:11434/v1"),
+            "timeout": float(os.environ.get("LOCAL_LLM_TIMEOUT", "600"))}
+
+
+def routed_model(model: str) -> str | None:
+    local = local_backend()
+    if not local:
+        return None
+    return local["map"].get(model) or local["model"]
@@ -10,0 +33,19 @@ def get_client(model: str, temperature: float, **kwargs) -> ModelWrapper:
+    local = local_backend()
+    target = routed_model(model)
+    if local and target:
+        from openai import OpenAI
+        # OpenAIClient builds a default OpenAI() first, which demands a key; it is replaced below.
+        os.environ.setdefault("OPENAI_API_KEY", "unused-local-backend")
+        extra = {}
+        if "openrouter.ai" in local["base_url"] or os.environ.get("LOCAL_LLM_REQUIRE_PARAMETERS"):
+            # Only route to providers that honour every request parameter (JSON mode in particular).
+            extra["extra_body"] = {"provider": {"require_parameters": True}}
+        client = OpenAICompatibleClient(target,
+                                        response_format={"type": "json_object"},
+                                        temperature=temperature,
+                                        max_tokens=int(os.environ.get("LOCAL_LLM_MAX_TOKENS", "1500")),
+                                        **extra,
+                                        **kwargs)
+        client.client = OpenAI(base_url=local["base_url"], api_key=os.environ.get("LOCAL_LLM_API_KEY", "local"),
+                               timeout=local["timeout"])
+        return client
diff --git a/src/resources/model_wrappers.py b/src/resources/model_wrappers.py
index 490dfa0..9f7452e 100644
--- a/src/resources/model_wrappers.py
+++ b/src/resources/model_wrappers.py
@@ -112,0 +113,23 @@ class OpenAIClient(ModelWrapper):
+class OpenAICompatibleClient(OpenAIClient):
+    """OpenAI-compatible servers (OpenRouter, Ollama, vLLM): send the widely supported `max_tokens`
+    instead of OpenAI's newer `max_completion_tokens`, plus optional `extra_body` routing options."""
+
+    def generate(self, messages: List[Message]) -> str:
+        for attempt in range(self.max_retries):
+            try:
+                response = self.client.chat.completions.create(
+                    model=self.model_name,
+                    messages=messages,
+                    temperature=self.temperature,
+                    max_tokens=self.max_tokens,
+                    top_p=self.top_p,
+                    **self.additional_params
+                )
+                return response.choices[0].message.content
+            except APIError as e:
+                logger.warning(f"API error (attempt {attempt + 1}/{self.max_retries}) for {self.model_name}: {str(e)}")
+                if attempt == self.max_retries - 1:
+                    logger.error(f"Failed after {self.max_retries} attempts: {str(e)}")
+                    return None
+                self._exponential_backoff(attempt)
+
