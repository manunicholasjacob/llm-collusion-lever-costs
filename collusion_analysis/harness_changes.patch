diff --git a/src/continuous_double_auction/market/agents.py b/src/continuous_double_auction/market/agents.py
index c9f87f2..a92fc25 100644
--- a/src/continuous_double_auction/market/agents.py
+++ b/src/continuous_double_auction/market/agents.py
@@ -127,0 +128,30 @@ class ZIPBuyer(Agent):
+class NoRegretSeller(Agent):
+    """
+    Algorithmic seller playing Hedge (multiplicative weights), a no-regret strategy (cf. Collina et al.
+    2025), over a fixed grid of asks. Full-information feedback: each hour it scores every grid ask
+    against the order book it observes (ask k-th lowest among the others' asks trades with the k-th
+    highest bid, at the midpoint) and updates all weights. Sends no messages; no model call.
+    """
+    ask_grid: list[float] = [80.5 + 0.5 * i for i in range(40)]  # 80.5 .. 100.0
+    weights: list[float] = []
+    eta: float = 1.0  # ~sqrt(8 ln K / T) for K=40 asks, T=30 hours, payoffs scaled to [0, 1]
+
+    def _payoff(self, ask: float, other_asks: list[float], bids_desc: list[float]) -> float:
+        k = sum(1 for a in other_asks if a < ask)
+        if k >= len(bids_desc) or ask > bids_desc[k]:
+            return 0.0
+        return max(0.0, (ask + bids_desc[k]) / 2 - self.valuation)
+
+    def generate_bid_response(self, **kwargs: Any) -> AgentBidResponse:
+        if not self.weights:
+            self.weights = [1.0] * len(self.ask_grid)
+        bids_desc = sorted((price for price, _ in kwargs.get("bid_queue", [])), reverse=True)
+        other_asks = [price for price, sid in kwargs.get("ask_queue", []) if sid != self.id]
+        scale = max(1.0, max(self.ask_grid) - self.valuation)
+        for i, a in enumerate(self.ask_grid):
+            self.weights[i] *= float(2.718281828 ** (self.eta * self._payoff(a, other_asks, bids_desc) / scale))
+        total = sum(self.weights)
+        self.weights = [w / total for w in self.weights]  # renormalise to avoid overflow
+        return {"ask": random.choices(self.ask_grid, weights=self.weights)[0]}
+
+
