@@ -190,0 +201,28 @@ class Market(BaseModel):
+    @staticmethod
+    def _as_price(value):
+        """float for numeric values or numeric strings, "null" for a withdrawal, None for anything else."""
+        if value is None or isinstance(value, bool):
+            return None
+        if isinstance(value, (int, float)):
+            return float(value)
+        if isinstance(value, str):
+            v = value.strip()
+            if v.lower() == "null":
+                return "null"
+            try:
+                return float(v.lstrip("$").replace(",", ""))
+            except ValueError:
+                return None
+        return None
+
+
+    def sample_messages_for_overseer(self, messages: dict[str, str]) -> dict[str, str]:
+        """Return the subset of seller messages the overseer reads this round
+        (adapted from the official sprint starter repo, poseidon-research/collusion_hackathon)."""
+        if self.overseer_sample_fraction >= 1.0 or not messages:
+            return dict(messages)
+        k = int(round(self.overseer_sample_fraction * len(messages)))
+        chosen = random.sample(sorted(messages), k)
+        return {sid: messages[sid] for sid in chosen}
+
+
